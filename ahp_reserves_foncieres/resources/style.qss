/* ==========================================================================
   Plugin AHP Réserves foncières - feuille de style
   Palette sobre alignée sur le thème QGIS par défaut, badges numérotés
   pour la navigation par étapes.
   ========================================================================== */

QDialog#AhpDialog {
    background-color: #f5f6f8;
}

/* --- Barre latérale ------------------------------------------------- */

QWidget#StepSidebar {
    background-color: #ffffff;
    border-right: 1px solid #e1e3e8;
}

QFrame#StepItem {
    border: none;
    border-radius: 4px;
    margin: 1px 6px;
}

QFrame#StepItem[checked="true"] {
    background-color: #eaf1fd;
}

QLabel#StepBadge {
    border-radius: 11px;
    border: 1px solid #c7cbd1;
    color: #6b7280;
    font-size: 11px;
    font-weight: 600;
    background-color: #ffffff;
}

QLabel#StepBadge[checked="true"] {
    background-color: #2f6fed;
    border: 1px solid #2f6fed;
    color: #ffffff;
}

QLabel#StepBadge[done="true"] {
    background-color: #2f9e63;
    border: 1px solid #2f9e63;
    color: #ffffff;
}

QLabel#StepLabel {
    color: #3c4149;
    font-size: 12px;
}

QLabel#StepLabel[checked="true"] {
    color: #1c2733;
    font-weight: 600;
}

/* --- Contenu principal ------------------------------------------------ */

QWidget#ContentPage {
    background-color: #ffffff;
}

QLabel#PageTitle {
    font-size: 15px;
    font-weight: 700;
    color: #1c2733;
}

QLabel#PageSubtitle {
    color: #6b7280;
    font-size: 12px;
}

QLabel#SectionLabel {
    color: #1c2733;
    font-weight: 600;
    font-size: 12px;
    margin-top: 4px;
}

QLabel#ReadOnlyValue {
    color: #1c2733;
    font-weight: 600;
}

QGroupBox {
    font-weight: 600;
    border: 1px solid #e1e3e8;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 12px;
    background-color: #fbfbfc;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #1c2733;
}

QTableWidget {
    border: 1px solid #e1e3e8;
    gridline-color: #eceef1;
}

QTableWidget::item {
    padding: 3px;
}

QHeaderView::section {
    background-color: #f5f6f8;
    border: none;
    border-bottom: 1px solid #e1e3e8;
    padding: 4px 6px;
    font-weight: 600;
    color: #3c4149;
}

QLabel#StatusPill {
    border-radius: 9px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#StatusPill[state="ok"] {
    background-color: #e4f6ec;
    color: #237a4b;
}

QLabel#StatusPill[state="error"] {
    background-color: #fdecec;
    color: #b23a3a;
}

QLabel#StatusPill[state="neutre"] {
    background-color: #eef0f3;
    color: #5b6472;
}

QPushButton#SecondaryButton:checked {
    background-color: #2f6fed;
    color: #ffffff;
    border-color: #2f6fed;
}

/* --- Barre de navigation basse ----------------------------------------- */

QFrame#NavBar {
    background-color: #ffffff;
    border-top: 1px solid #e1e3e8;
}

QPushButton#PrimaryButton {
    background-color: #2f6fed;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 6px 18px;
    font-weight: 600;
}

QPushButton#PrimaryButton:hover {
    background-color: #2559c9;
}

QPushButton#PrimaryButton:disabled {
    background-color: #a9c0f2;
    color: #eef2fb;
}

QPushButton#SecondaryButton {
    background-color: #ffffff;
    color: #3c4149;
    border: 1px solid #c7cbd1;
    border-radius: 4px;
    padding: 6px 18px;
}

QPushButton#SecondaryButton:hover {
    background-color: #f0f1f3;
}

QPushButton#SecondaryButton:disabled {
    color: #b0b4ba;
}
